{
  "info": {
    "name": "Weeks 31–32 — Status & Diagnostics",
    "_postman_id": "f1aa54c2-96e4-4a56-9c65-7a3b2afbe731",
    "description": "Status flags, health pings, problem reports, A/B cohorts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://YOUR_REF.functions.supabase.co" },
    { "key": "api_key", "value": "SERVICE_OR_ANON_KEY" },
    { "key": "org_id", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "user_id", "value": "11111111-1111-1111-1111-111111111111" }
  ],
  "item": [
    {
      "name": "Status — Get",
      "request": {
        "method": "GET",
        "header": [
          { "key": "apikey", "value": "{{api_key}}" },
          { "key": "Authorization", "value": "Bearer {{api_key}}" }
        ],
        "url": { "raw": "{{baseUrl}}/status_get", "host": [ "{{baseUrl}}" ], "path": [ "status_get" ] }
      }
    },
    {
      "name": "Health — Ping",
      "request": {
        "method": "GET",
        "header": [
          { "key": "apikey", "value": "{{api_key}}" },
          { "key": "Authorization", "value": "Bearer {{api_key}}" }
        ],
        "url": { "raw": "{{baseUrl}}/health_ping?component=edge:status", "host": [ "{{baseUrl}}" ], "path": [ "health_ping" ], "query": [ { "key": "component", "value": "edge:status" } ] }
      }
    },
    {
      "name": "Support — Report Problem",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "apikey", "value": "{{api_key}}" },
          { "key": "Authorization", "value": "Bearer {{api_key}}" }
        ],
        "url": { "raw": "{{baseUrl}}/report_problem", "host": [ "{{baseUrl}}" ], "path": [ "report_problem" ] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"org_id\": \"{{org_id}}\",\n  \"user_id\": \"{{user_id}}\",\n  \"route\": \"/loads\",\n  \"trace_id\": \"trace-12345\",\n  \"last_errors\": [{\"code\": \"ERR_TIMEOUT\"}],\n  \"device\": {\"os\": \"Android\", \"app_version\": \"1.2.3\"},\n  \"notes\": \"Buttons unresponsive after refresh\"\n}"
        }
      }
    },
    {
      "name": "AB — Assign cohort",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "apikey", "value": "{{api_key}}" },
          { "key": "Authorization", "value": "Bearer {{api_key}}" }
        ],
        "url": { "raw": "{{baseUrl}}/ab_assign", "host": [ "{{baseUrl}}" ], "path": [ "ab_assign" ] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"experiment_key\": \"status_banner_variant\",\n  \"user_id\": \"{{user_id}}\",\n  \"org_id\": \"{{org_id}}\",\n  \"cohorts\": [\"control\",\"phase3\"]\n}"
        }
      }
    }
  ]
}
