            "url": { "raw": "{{baseUrl}}/api/shipper/loads", "host": [ "{{baseUrl}}" ], "path": [ "api", "shipper", "loads" ] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin_zip\": \"30301\",\n  \"dest_zip\": \"75201\",\n  \"equipment\": \"van\",\n  \"pickup_date\": \"2025-10-02\",\n  \"delivery_date\": \"2025-10-04\",\n  \"offered_rate\": 1800\n}"
            }
