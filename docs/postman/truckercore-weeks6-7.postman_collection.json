            ],
            "url": { "raw": "{{baseUrl}}/api/dispatch/auto_assign", "host": [ "{{baseUrl}}" ], "path": [ "api", "dispatch", "auto_assign" ] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"load_id\": \"{{load_id}}\",\n  \"constraints\": {\"equipment\": \"van\", \"min_hos_minutes\": 240}\n}"
            }
          }
        }
      ]
    },
