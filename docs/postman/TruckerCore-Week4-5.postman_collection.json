    {
      "name": "ETA v2 (P50/P80)",
      "item": [
        {
          "name": "Predict ETA with P50/P80",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "url": { "raw": "{{baseUrl}}/api/ai/eta_predict", "host": [ "{{baseUrl}}" ], "path": [ "api", "ai", "eta_predict" ] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": {\"lat\": 33.7489, \"lng\": -84.3881},\n  \"dest\": {\"lat\": 41.8781, \"lng\": -87.6298},\n  \"departure_time\": \"2025-09-12T16:00:00Z\",\n  \"polyline\": \"ENCODED_POLYLINE\",\n  \"truck\": {\"height_ft\": 13.5, \"weight_lbs\": 78000, \"hazmat\": false}\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('has totals and legs', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.legs).to.be.an('array');",
                  "  pm.expect(j.total).to.have.property('p50_minutes');",
                  "  pm.expect(j.total).to.have.property('p80_minutes');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
