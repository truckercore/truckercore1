  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Ping /auth/me (optional sanity)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": [ "{{baseUrl}}" ], "path": [ "auth", "me" ] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200 or 404 (if not implemented)', function () {",
                  "  pm.expect([200,404]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "ELD Integration",
      "item": [
        {
          "name": "Connect Provider A",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "url": { "raw": "{{baseUrl}}/api/integrations/eld/provider-a/connect", "host": [ "{{baseUrl}}" ], "path": [ "api", "integrations", "eld", "provider-a", "connect" ] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"org_id\": \"c5b43b71-8b9c-4c66-9e40-6c2b6d3f5c3a\",\n  \"auth_code\": \"AUTH_CODE_FROM_PROVIDER\",\n  \"redirect_uri\": \"app://callback/eld/provider-a\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.expect(json.connected).to.be.true;",
                  "pm.expect(json.provider).to.eql('provider_a');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Provider A Webhook (HOS update, simulate)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "X-Signature", "value": "sha256=BASE64_SIG", "type": "text" }
            ],
            "url": { "raw": "{{baseUrl}}/api/integrations/eld/provider-a/webhook", "host": [ "{{baseUrl}}" ], "path": [ "api", "integrations", "eld", "provider-a", "webhook" ] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"9b8d54a2-f3a0-49f2-9d5a-e2e194b7c2c0\",\n  \"timestamp\": \"2025-09-12T21:01:34Z\",\n  \"type\": \"hos.updated\",\n  \"org_external_id\": \"ACME-123\",\n  \"driver_external_id\": \"DRV-567\",\n  \"logs\": [\n    {\"start_time\":\"2025-09-12T12:00:00Z\",\"end_time\":\"2025-09-12T14:10:00Z\",\"status\":\"driving\",\"source\":\"eld\",\"violations\":[]},\n    {\"start_time\":\"2025-09-12T14:10:00Z\",\"end_time\":\"2025-09-12T15:40:00Z\",\"status\":\"on\",\"source\":\"eld\",\"violations\":[{\"code\":\"14HR\",\"minutes\":25}]}\n  ],\n  \"signature\": \"sha256=BASE64_SIG\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('accepted true', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().accepted).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
