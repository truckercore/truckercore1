            "url": { "raw": "{{baseUrl}}/api/broker/trust/{{broker_id}}", "host": [ "{{baseUrl}}" ], "path": [ "api", "broker", "trust", "{{broker_id}}" ] }
          }
        },
        {
          "name": "Append Audit Event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "url": { "raw": "{{baseUrl}}/api/audit/event", "host": [ "{{baseUrl}}" ], "path": [ "api", "audit", "event" ] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject_type\": \"broker\",\n  \"subject_id\": \"{{broker_id}}\",\n  \"action\": \"verification_viewed\",\n  \"payload\": { \"user_id\": \"{{user_id}}\", \"dot\": \"1234562\" }\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Enterprise: API Keys & Webhooks",
      "item": [
