            ],
            "url": { "raw": "{{baseUrl}}/api/admin/webhooks", "host": [ "{{baseUrl}}" ], "path": [ "api", "admin", "webhooks" ] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"load.created\",\n  \"url\": \"https://hooks.example.com/loads\",\n  \"secret\": \"whsec_abc123\"\n}"
            }
          }
        }
      ]
    },
    {
