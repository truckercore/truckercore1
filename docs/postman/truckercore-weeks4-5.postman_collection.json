{
  "info": {
    "name": "TruckerCore API – Weeks 4–5",
    "_postman_id": "3fa65c2c-5c2f-4e5a-a1be-4a1c7e1e22f9",
    "description": "Contract-first collection for ELD, HOS, ETA v2, Tri-haul, Route Optimize, Maintenance, Trust/Audit, API Keys/Webhooks, Costs Estimator, Offline, Exports.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "ELD Integration",
      "item": [
        {
          "name": "Connect Provider A",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "url": { "raw": "{{baseUrl}}/api/integrations/eld/provider-a/connect", "host": [ "{{baseUrl}}" ], "path": [ "api", "integrations", "eld", "provider-a", "connect" ] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"org_id\": \"{{org_id}}\",\n  \"auth_code\": \"AUTH_CODE_FROM_PROVIDER\",\n  \"redirect_uri\": \"app://callback/eld/provider-a\"\n}"
            }
          }
        },
        {
          "name": "Provider A Webhook (simulate HOS update)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "X-Signature", "value": "sha256=BASE64_SIG", "type": "text" }
            ],
            "url": { "raw": "{{baseUrl}}/api/integrations/eld/provider-a/webhook", "host": [ "{{baseUrl}}" ], "path": [ "api", "integrations", "eld", "provider-a", "webhook" ] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{uuid}}\",\n  \"timestamp\": \"{{now_iso}}\",\n  \"type\": \"hos.updated\",\n  \"org_external_id\": \"ACME-123\",\n  \"driver_external_id\": \"DRV-567\",\n  \"logs\": [\n    {\"start_time\":\"2025-09-12T12:00:00Z\",\"end_time\":\"2025-09-12T14:10:00Z\",\"status\":\"driving\",\"source\":\"eld\",\"violations\":[]},\n    {\"start_time\":\"2025-09-12T14:10:00Z\",\"end_time\":\"2025-09-12T15:40:00Z\",\"status\":\"on\",\"source\":\"eld\",\"violations\":[{\"code\":\"14HR\",\"minutes\":25}]}\n  ],\n  \"signature\": \"sha256=BASE64_SIG\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "HOS & Compliance",
      "item": [
        {
          "name": "Get HOS with Violations",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hos/{{driver_user_id}}?from={{from_date}}&to={{to_date}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "hos", "{{driver_user_id}}" ],
              "query": [
                { "key": "from", "value": "{{from_date}}" },
                { "key": "to", "value": "{{to_date}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ETA v2 (P50/P80)",
      "item": [
        {
          "name": "Predict ETA with P50/P80",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "url": { "raw": "{{baseUrl}}/api/ai/eta_predict", "host": [ "{{baseUrl}}" ], "path": [ "api", "ai", "eta_predict" ] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": {\"lat\": 33.7489, \"lng\": -84.3881},\n  \"dest\": {\"lat\": 41.8781, \"lng\": -87.6298},\n  \"departure_time\": \"{{now_iso}}\",\n  \"polyline\": \"ENCODED_POLYLINE\",\n  \"truck\": {\"height_ft\": 13.5, \"weight_lbs\": 78000, \"hazmat\": false}\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Tri-haul",
      "item": [
        {
          "name": "Suggest Tri-hauls",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "url": { "raw": "{{baseUrl}}/api/trihaul/suggest", "host": [ "{{baseUrl}}" ], "path": [ "api", "trihaul", "suggest" ] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin_zip\": \"30301\",\n  \"dest_zip\": \"75201\",\n  \"date\": \"2025-09-20\",\n  \"equipment\": \"van\",\n  \"constraints\": {\"max_detour_ratio\": 0.35, \"min_est_ppm\": 2.1, \"avoid_tolls\": false}\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Route Optimize",
      "item": [
        {
          "name": "Optimize Multi-stop Route",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "url": { "raw": "{{baseUrl}}/api/ai/route_optimize", "host": [ "{{baseUrl}}" ], "path": [ "api", "ai", "route_optimize" ] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stops\": [\n    {\"id\":\"A\",\"lat\":39.0997,\"lng\":-94.5786,\"window\":{\"start\":\"2025-09-13T08:00:00Z\",\"end\":\"2025-09-13T10:00:00Z\"}},\n    {\"id\":\"B\",\"lat\":41.2565,\"lng\":-95.9345,\"window\":{\"start\":\"2025-09-13T13:00:00Z\",\"end\":\"2025-09-13T15:00:00Z\"}},\n    {\"id\":\"C\",\"lat\":41.8781,\"lng\":-87.6298}\n  ],\n  \"truck\": {\"height_ft\": 13.5, \"weight_lbs\": 80000},\n  \"constraints\": {\"avoid_tolls\": true, \"optimize_for\": \"time\"}\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Maintenance",
      "item": [
        {
          "name": "Get Schedules (Upcoming)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/maintenance/schedules?status=upcoming&within_days=30",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "maintenance", "schedules" ],
              "query": [
                { "key": "status", "value": "upcoming" },
                { "key": "within_days", "value": "30" }
              ]
            }
          }
        },
        {
          "name": "Create Work Order (from DVIR)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "url": { "raw": "{{baseUrl}}/api/maintenance/workorders", "host": [ "{{baseUrl}}" ], "path": [ "api", "maintenance", "workorders" ] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_id\": \"veh-001\",\n  \"source\": \"dvir\",\n  \"defects\": [{\"component\": \"brakes\", \"severity\": \"major\", \"note\": \"Soft pedal\"}]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Broker Trust & Audits",
      "item": [
        {
          "name": "Get Trust Score",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
